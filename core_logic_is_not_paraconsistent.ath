#============================================================================
# core_logic_is_not_paraconsistent_concise.ath
#
# Condensed version of core_logic_is_not_paraconsistent.ath (1485 l.).
# Same final theorem (claim1-false), same two explicit axioms
# (Claim1-Tennant, min-antisequent-rule-to-core), same encoding of
# reified derivations (datatype Deriv + well-formed + derivable),
# faithful to the Coq script core_logic_is_not_paraconsistent.v.
#
# The compression rests on four generic methods:
#
#   prove-trivia  -- proves any conjunction each of whose conjuncts is
#                   either a reflexivity (t = t) or already in the
#                   assumption base; replaces the repeated
#                   reflex/conj-intro boilerplate.
#   wf-elim       -- elimination of a well-formed clause: uspec* of the
#                   biconditional + left-iff + mp. The instance lists
#                   are copied VERBATIM from the validated long file
#                   (the quantifier order of assert* was established
#                   there empirically).
#   refute-mem    -- refutes (mem x L) by recursion on L, provided the
#                   inequalities (x =/= element) are in the assumption
#                   base; replaces the three !cases cascades on mem-def.
#   both-orders   -- (local to DNS1-inv): dispatches the disjunction of
#                   the two context orderings to a single "kill" method
#                   parameterized by the ordering; halves the body of
#                   the Hgen induction.
#
# The five introduction methods (ax!, lneg!, exch!, rac!, larrow!)
# remain but each now takes ~6 lines thanks to prove-trivia. The
# scaffolding test theorems (TEST 1, ax-leaf-wf-via-method) of the long
# version are removed.
#
# Constructions worth noting (all documented in FPMICS):
#   (1) the patterns (and (some-list _)) and
#       (= (some-term l) (some-term r)) in prove-trivia;
#   (2) anonymous methods passed to both-orders;
#   (3) check {... => ... | else => ...} in the L-> and Exchange
#       branches of Hgen.
#============================================================================

# --- Datatypes (unchanged) ---

datatype Formula :=
    (Var Ide)
  | (Neg Formula)
  | (Impl Formula Formula)

datatype Succedent :=
    none-succ
  | (some-succ Formula)

datatype Fragment := minimal-F | core-logic

datatype Deriv :=
    (ax-rule Fragment (List Formula) Formula)
  | (l-neg-rule Fragment (List Formula) Formula Deriv)
  | (r-arrow-rule Fragment (List Formula) Formula Formula Deriv)
  | (l-arrow-rule Fragment (List Formula) Formula Formula Succedent
                  Deriv Deriv)
  | (exchange-rule Fragment Formula Formula Succedent Deriv)
  | (r-arrow-core-rule (List Formula) Formula Formula Deriv)

# Free-generation axioms (no-confusion + injectivity), asserted into
# the assumption base.

assert (datatype-axioms "Succedent")
assert (datatype-axioms "Formula")
assert (datatype-axioms "Fragment")
assert (datatype-axioms "List")

# Named accessors for the no-confusion axioms reused below.

define formula-axioms := (datatype-axioms "Formula")
define neg-neq-impl  := (head formula-axioms)                # Neg x =/= Impl y z
define var-neq-neg   := (head (tail formula-axioms))         # Var x =/= Neg y
define var-neq-impl  := (head (tail (tail formula-axioms)))  # Var x =/= Impl y z
define succ-axioms   := (datatype-axioms "Succedent")
define none-neq-some := (head succ-axioms)                   # none =/= some y

# --- Variable abbreviations (unchanged) ---

define [A B C]      := [?A:Formula ?B:Formula ?C:Formula]
define [G G']       := [?G:(List Formula) ?G':(List Formula)]
define [f f']       := [?f:Fragment ?f':Fragment]
define [S S']       := [?S:Succedent ?S':Succedent]
define [Sc Sc']     := [?Sc:Succedent ?Sc':Succedent]
define [d d1 d2]    := [?d:Deriv ?d1:Deriv ?d2:Deriv]
define [x y]        := [?x:Formula ?y:Formula]

# --- Membership predicate ---

declare mem : [Formula (List Formula)] -> Boolean

assert* mem-def :=
  [(~ (mem A nil))
   ((mem A (B :: G)) <==> (A = B | mem A G))]

# --- Well-formedness of a derivation tree (clauses unchanged) ---

declare well-formed : [Deriv Fragment (List Formula) Succedent] -> Boolean

assert* wf-ax :=
  [((well-formed (ax-rule f G A) f' G' S)
      <==>
    (f = f' & G = G' & S = (some-succ A) & mem A G))]

assert* wf-l-neg :=
  [((well-formed (l-neg-rule f G A d) f' G' S)
      <==>
    (f = f' & G' = ((Neg A) :: G) & S = none-succ
     & (well-formed d f G (some-succ A))))]

assert* wf-r-arrow :=
  [((well-formed (r-arrow-rule f G A B d) f' G' S)
      <==>
    (f = f' & G = G' & S = (some-succ (Impl A B))
     & (well-formed d f (A :: G) (some-succ B))))]

assert* wf-l-arrow :=
  [((well-formed (l-arrow-rule f G A B Sc d1 d2) f' G' S')
      <==>
    (f = f' & G' = ((Impl A B) :: G) & Sc = S'
     & (well-formed d1 f G (some-succ A))
     & (well-formed d2 f (B :: G) Sc)))]

assert* wf-exchange :=
  [((well-formed (exchange-rule f x y Sc d) f' G' S')
      <==>
    (f = f' & G' = (y :: (x :: nil)) & Sc = S'
     & (well-formed d f (x :: (y :: nil)) Sc)))]

assert* wf-r-arrow-core :=
  [((well-formed (r-arrow-core-rule G A B d) f' G' S)
      <==>
    (f' = core-logic & G = G' & S = (some-succ (Impl A B))
     & (well-formed d core-logic (A :: G) none-succ)))]

# --- The predicate "derivable" ---

declare derivable : [Fragment (List Formula) Succedent] -> Boolean

assert* derivable-def :=
  [((derivable f G S) <==> (exists ?d:Deriv . (well-formed ?d f G S)))]

#============================================================================
# GENERIC TOOLBOX
#============================================================================

# prove-trivia: proves a sentence p that is a conjunction (of arbitrary
# depth) each of whose leaves is either a reflexive identity (t = t),
# proved by !reflex, or a sentence already in the assumption base,
# claimed by !claim. All leaves are first established (map-method),
# then conj-intro assembles the conjunction (the conjuncts of a
# sentence in the assumption base are themselves in the base,
# cf. FPMICS Section 2.10).

define prove-trivia :=
  method (p)
    match p {
      (and (some-list conjuncts)) =>
        (!map-method prove-trivia conjuncts
           method (_) (!conj-intro p))
    | (= (some-term l) (some-term r)) =>
        check {(l equal? r) => (!reflex l) | else => (!claim p)}
    | _ => (!claim p)
    }

# wf-elim: elimination of a well-formedness clause. w is the premise
# (well-formed (C ...) f' G' S); clause is the named list (wf-ax,
# wf-l-neg, ...); instances is the uspec* instantiation list, in the
# order validated by the long version:
#   wf-ax           : [A G S f G' f']
#   wf-l-neg        : [A G S d f G' f']
#   wf-r-arrow      : [A B G S d f G' f']
#   wf-l-arrow      : [A B G f G' S' Sc d1 d2 f']
#   wf-exchange     : [d f x y G' S' Sc f']
#   wf-r-arrow-core : [A B G S d G' f']
# The result is the right-hand conjunction of the biconditional; its
# conjuncts automatically enter the assumption base.

define wf-elim :=
  method (w clause instances)
    (!mp (!left-iff (!uspec* (head clause) instances)) w)

# refute-mem: derives false from (mem x L) in the assumption base,
# provided that for each element h of L the inequality (x =/= h) is
# already in the base. Structural recursion on the list term L; the
# nil case is closed by the first clause of mem-def.

define refute-mem :=
  method (x L)
    match L {
      (h :: t) =>
        let { disj := (!chain->
                        [(mem x L) ==> (x = h | mem x t) [mem-def]]) }
          (!cases disj
            (assume e1 := (x = h)
              (!absurd e1 (!claim (x =/= h))))
            (assume e2 := (mem x t)
              (!refute-mem x t)))
    | _ => (!absurd (!claim (mem x nil))
                    (!instance (head mem-def) [x]))
    }

# The five introductions, one per rule of F (R-> is never built, only
# inverted; no introduction method for it).

define ax! :=
  method (fr Gamma phi)
    let { rhs := (fr = fr & Gamma = Gamma
                  & (some-succ phi) = (some-succ phi)
                  & (mem phi Gamma));
          _ := (!prove-trivia rhs) }
      (!chain<-
        [(well-formed (ax-rule fr Gamma phi) fr Gamma (some-succ phi))
          <== rhs                                            [wf-ax]])

define lneg! :=
  method (fr Gamma phi dprem)
    let { rhs := (fr = fr
                  & ((Neg phi) :: Gamma) = ((Neg phi) :: Gamma)
                  & none-succ = none-succ
                  & (well-formed dprem fr Gamma (some-succ phi)));
          _ := (!prove-trivia rhs) }
      (!chain<-
        [(well-formed (l-neg-rule fr Gamma phi dprem)
                      fr ((Neg phi) :: Gamma) none-succ)
          <== rhs                                            [wf-l-neg]])

define exch! :=
  method (fr xf yf sc dprem)
    let { rhs := (fr = fr
                  & (yf :: (xf :: nil)) = (yf :: (xf :: nil))
                  & sc = sc
                  & (well-formed dprem fr (xf :: (yf :: nil)) sc));
          _ := (!prove-trivia rhs) }
      (!chain<-
        [(well-formed (exchange-rule fr xf yf sc dprem)
                      fr (yf :: (xf :: nil)) sc)
          <== rhs                                            [wf-exchange]])

define rac! :=
  method (Gamma A B dprem)
    let { rhs := (core-logic = core-logic & Gamma = Gamma
                  & (some-succ (Impl A B)) = (some-succ (Impl A B))
                  & (well-formed dprem core-logic (A :: Gamma) none-succ));
          _ := (!prove-trivia rhs) }
      (!chain<-
        [(well-formed (r-arrow-core-rule Gamma A B dprem)
                      core-logic Gamma (some-succ (Impl A B)))
          <== rhs                                            [wf-r-arrow-core]])

define larrow! :=
  method (fr Gamma A B sc dleft dright)
    let { rhs := (fr = fr
                  & ((Impl A B) :: Gamma) = ((Impl A B) :: Gamma)
                  & sc = sc
                  & (well-formed dleft fr Gamma (some-succ A))
                  & (well-formed dright fr (B :: Gamma) sc));
          _ := (!prove-trivia rhs) }
      (!chain<-
        [(well-formed (l-arrow-rule fr Gamma A B sc dleft dright)
                      fr ((Impl A B) :: Gamma) sc)
          <== rhs                                            [wf-l-arrow]])

# derivable!: closes the existential on the witness d (whose
# well-formedness is assumed to be in the base) and concludes
# derivable.

define derivable! :=
  method (fr Gamma S d)
    let { _ := (!egen (exists ?dd:Deriv . (well-formed ?dd fr Gamma S)) d) }
      (!chain<-
        [(derivable fr Gamma S)
          <== (exists ?dd:Deriv . (well-formed ?dd fr Gamma S))
                                                             [derivable-def]])

#============================================================================
# THEOREM absurdity-core:  Var a, Neg(Var a) |-   in core-logic.
# Coq: Exchange; L_neg; Ax.
#============================================================================

define absurdity-core :=
  (forall ?a:Ide .
    (derivable core-logic
               ((Var ?a) :: ((Neg (Var ?a)) :: nil))
               none-succ))

conclude absurdity-core
  pick-any a:Ide
    let { va := (Var a); na := (Neg va);
          t-ax   := (ax-rule core-logic (va :: nil) va);
          t-lneg := (l-neg-rule core-logic (va :: nil) va t-ax);
          t-exch := (exchange-rule core-logic na va none-succ t-lneg);
          _ := (!chain-> [(va = va) ==> (mem va (va :: nil)) [mem-def]]);
          _ := (!ax!   core-logic (va :: nil) va);
          _ := (!lneg! core-logic (va :: nil) va t-ax);
          _ := (!exch! core-logic na va none-succ t-lneg) }
      (!derivable! core-logic (va :: (na :: nil)) none-succ t-exch)

#============================================================================
# THEOREM DNS2-instantiated:
#       A, D |-
#  --------------------- DNS.2     (A = Var a, B = Var b, D = [Neg A])
#  (A -> B) -> B, D |- B
# Coq: L_arrow ( R_arrow_core H | Ax ).
#============================================================================

define DNS2-instantiated :=
  (forall ?a:Ide ?b:Ide .
    (derivable core-logic
               ((Var ?a) :: ((Neg (Var ?a)) :: nil))
               none-succ)
    ==>
    (derivable core-logic
               ((Impl (Impl (Var ?a) (Var ?b)) (Var ?b))
                 :: ((Neg (Var ?a)) :: nil))
               (some-succ (Var ?b))))

conclude DNS2-instantiated
  pick-any a:Ide b:Ide
    let { va := (Var a); vb := (Var b); na := (Neg va) }
      assume hyp := (derivable core-logic (va :: (na :: nil)) none-succ)
        let { ex-prem := (!chain->
                           [hyp
                             ==> (exists ?d:Deriv .
                                    (well-formed ?d core-logic
                                       (va :: (na :: nil)) none-succ))
                                 [derivable-def]]) }
          pick-witness w for ex-prem
            # (well-formed w core-logic [va, na] none-succ) is now in
            # the assumption base.
            let { t-rac := (r-arrow-core-rule (na :: nil) va vb w);
                  t-ax  := (ax-rule core-logic (vb :: (na :: nil)) vb);
                  t-la  := (l-arrow-rule core-logic (na :: nil)
                                         (Impl va vb) vb
                                         (some-succ vb) t-rac t-ax);
                  _ := (!rac! (na :: nil) va vb w);
                  _ := (!chain-> [(vb = vb)
                                   ==> (mem vb (vb :: (na :: nil)))
                                       [mem-def]]);
                  _ := (!ax! core-logic (vb :: (na :: nil)) vb);
                  _ := (!larrow! core-logic (na :: nil)
                                 (Impl va vb) vb (some-succ vb)
                                 t-rac t-ax) }
              (!derivable! core-logic
                           ((Impl (Impl va vb) vb) :: (na :: nil))
                           (some-succ vb)
                           t-la)

#============================================================================
# LEMMA R-arrow-inv-NegA-min:
#    [Neg A] |- A -> B
#    -----------------  (inversion of R-> over the singleton context)
#    A, [Neg A] |- B
#
# datatype-cases on the witness: five impossible branches (closed by
# no-confusion via wf-elim + absurd/refute-mem), one productive (R->).
#============================================================================

define R-arrow-inv-NegA-min :=
  (forall ?a:Ide ?b:Ide .
    (derivable minimal-F
               ((Neg (Var ?a)) :: nil)
               (some-succ (Impl (Var ?a) (Var ?b))))
    ==>
    (derivable minimal-F
               ((Var ?a) :: ((Neg (Var ?a)) :: nil))
               (some-succ (Var ?b))))

conclude R-arrow-inv-NegA-min
  pick-any a:Ide b:Ide
    let { va := (Var a); vb := (Var b); na := (Neg va);
          ab := (Impl va vb);             # the succedent to invert
          ctx := (na :: nil);
          succ := (some-succ ab);
          goal := (derivable minimal-F (va :: (na :: nil)) (some-succ vb)) }
      assume hyp := (derivable minimal-F ctx succ)
        let { ex-d := (!chain->
                        [hyp
                          ==> (exists ?d:Deriv .
                                 (well-formed ?d minimal-F ctx succ))
                              [derivable-def]]);
              # The conditional property mentions the case variable
              # (same structural trick as in the long version).
              inv-prop :=
                (forall ?dd:Deriv .
                  (well-formed ?dd minimal-F ctx succ) ==> goal);
              inv-proof :=
                datatype-cases inv-prop {
                    (ax-rule f0 G0 phi0) =>
                      # mem (A->B) [Neg A] is impossible.
                      assume w := (well-formed (ax-rule f0 G0 phi0)
                                     minimal-F ctx succ)
                        let { _ := (!wf-elim w wf-ax
                                     [phi0 G0 succ f0 ctx minimal-F]);
                              phi0-eq := (!chain->
                                           [(succ = some-succ phi0)
                                             ==> (ab = phi0)
                                                 [(datatype-axioms "Succedent")]]);
                              _ := (!chain->
                                     [(mem phi0 G0)
                                       ==> (mem ab ctx)
                                           [phi0-eq (G0 = ctx)]]);
                              # ab =/= na, by symmetrized no-confusion.
                              _ := (!sym (!instance neg-neq-impl [va va vb]));
                              _ := (!refute-mem ab ctx) }
                          (!from-false goal)
                  | (l-neg-rule f0 G0 A0 d0) =>
                      # Succedent none-succ vs some-succ: impossible.
                      assume w := (well-formed (l-neg-rule f0 G0 A0 d0)
                                     minimal-F ctx succ)
                        let { _ := (!wf-elim w wf-l-neg
                                     [A0 G0 succ d0 f0 ctx minimal-F]);
                              _ := (!absurd (succ = none-succ)
                                     (!sym (!instance none-neq-some [ab]))) }
                          (!from-false goal)
                  | (r-arrow-rule f0 G0 A0 B0 d0) =>
                      # PRODUCTIVE case: the premise of R-> is the goal.
                      assume w := (well-formed (r-arrow-rule f0 G0 A0 B0 d0)
                                     minimal-F ctx succ)
                        let { _ := (!wf-elim w wf-r-arrow
                                     [A0 B0 G0 succ d0 f0 ctx minimal-F]);
                              impl-eq := (!chain->
                                           [(succ = some-succ (Impl A0 B0))
                                             ==> (ab = (Impl A0 B0))
                                                 [(datatype-axioms "Succedent")]]);
                              a-eq := (!chain->
                                        [impl-eq ==> (va = A0)
                                             [(datatype-axioms "Formula")]]);
                              b-eq := (!chain->
                                        [impl-eq ==> (vb = B0)
                                             [(datatype-axioms "Formula")]]);
                              _ := (!chain->
                                     [(well-formed d0 f0 (A0 :: G0)
                                        (some-succ B0))
                                       ==> (well-formed d0 minimal-F
                                              (va :: (na :: nil))
                                              (some-succ vb))
                                           [(f0 = minimal-F) (G0 = ctx)
                                            a-eq b-eq]]) }
                          (!derivable! minimal-F (va :: (na :: nil))
                                       (some-succ vb) d0)
                  | (l-arrow-rule f0 G0 A0 B0 sc0 d1 d2) =>
                      # Context head Neg vs Impl: impossible.
                      assume w := (well-formed
                                     (l-arrow-rule f0 G0 A0 B0 sc0 d1 d2)
                                     minimal-F ctx succ)
                        let { _ := (!wf-elim w wf-l-arrow
                                     [A0 B0 G0 f0 ctx succ sc0 d1 d2
                                      minimal-F]);
                              head-eq := (!chain->
                                           [(ctx = ((Impl A0 B0) :: G0))
                                             ==> (na = (Impl A0 B0))
                                                 [(datatype-axioms "List")]]);
                              _ := (!absurd head-eq
                                     (!instance neg-neq-impl [va A0 B0])) }
                          (!from-false goal)
                  | (exchange-rule f0 xf0 yf0 sc0 d0) =>
                      # Singleton vs doubleton context: impossible.
                      assume w := (well-formed
                                     (exchange-rule f0 xf0 yf0 sc0 d0)
                                     minimal-F ctx succ)
                        let { _ := (!wf-elim w wf-exchange
                                     [d0 f0 xf0 yf0 ctx succ sc0 minimal-F]);
                              tail-eq := (!chain->
                                           [(ctx = (yf0 :: (xf0 :: nil)))
                                             ==> (nil = (xf0 :: nil))
                                                 [(datatype-axioms "List")]]);
                              nil-noconf := (!chain->
                                              [true
                                                ==> (nil =/= (xf0 :: nil))
                                                    [(datatype-axioms "List")]]);
                              _ := (!absurd tail-eq nil-noconf) }
                          (!from-false goal)
                  | (r-arrow-core-rule G0 A0 B0 d0) =>
                      # Fragment core-logic vs minimal-F: impossible.
                      assume w := (well-formed
                                     (r-arrow-core-rule G0 A0 B0 d0)
                                     minimal-F ctx succ)
                        let { _ := (!wf-elim w wf-r-arrow-core
                                     [A0 B0 G0 succ d0 ctx minimal-F]);
                              _ := (!absurd (minimal-F = core-logic)
                                     (head (datatype-axioms "Fragment"))) }
                          (!from-false goal)
                }
            }
          pick-witness w for ex-d wf-w
            (!mp (!uspec inv-proof w) wf-w)

#============================================================================
# THEOREM DNS1-inv-instantiated:
#    (A -> B) -> B, D |- B
#    ---------------------  (invertibility of DNS.1)
#         A, D |- B
#
# Structural induction on the witness (by-induction), generalized over
# BOTH orderings of the doubleton context (the Hgen disjunction) to
# absorb the Exchange case -- the exact analogue of Coq's Hgen. The
# local method both-orders factors the duplicated case analysis.
#============================================================================

define DNS1-inv-instantiated :=
  (forall ?a:Ide ?b:Ide .
    (derivable minimal-F
               ((Impl (Impl (Var ?a) (Var ?b)) (Var ?b))
                 :: ((Neg (Var ?a)) :: nil))
               (some-succ (Var ?b)))
    ==>
    (derivable minimal-F
               ((Var ?a) :: ((Neg (Var ?a)) :: nil))
               (some-succ (Var ?b))))

conclude DNS1-inv-instantiated
  pick-any a:Ide b:Ide
    let { va := (Var a); vb := (Var b); na := (Neg va);
          phi := (Impl (Impl va vb) vb);            # (A -> B) -> B
          ord1 := (phi :: (na :: nil));
          ord2 := (na :: (phi :: nil));
          sb := (some-succ vb);
          target := (derivable minimal-F (va :: (na :: nil)) sb);
          # Inequalities used by refute-mem in the Ax case, established
          # once and for all: vb =/= phi and vb =/= na.
          _ := (!instance var-neq-impl [b (Impl va vb) vb]);
          _ := (!instance var-neq-neg [b va]);
          # both-orders: given the constructor term D and a kill method
          # (w, ord) |-> target, proves the disjunctive implication
          # required by the induction branch.
          both-orders :=
            method (D kill)
              let { wf1 := (well-formed D minimal-F ord1 sb);
                    wf2 := (well-formed D minimal-F ord2 sb) }
                assume disj := (wf1 | wf2)
                  (!cases disj
                    (assume w1 := wf1 (!kill w1 ord1))
                    (assume w2 := wf2 (!kill w2 ord2)));
          Hgen :=
            (forall ?dd:Deriv .
              ((well-formed ?dd minimal-F ord1 sb)
               | (well-formed ?dd minimal-F ord2 sb))
              ==> target);
          Hgen-proof :=
            by-induction Hgen {
                (ax-rule f0 G0 phi0) =>
                  # Var b belongs to neither ordering.
                  (!both-orders (ax-rule f0 G0 phi0)
                    method (w ord)
                      let { _ := (!wf-elim w wf-ax
                                   [phi0 G0 sb f0 ord minimal-F]);
                            phi0-eq := (!chain->
                                         [(sb = some-succ phi0)
                                           ==> (vb = phi0)
                                               [(datatype-axioms "Succedent")]]);
                            _ := (!chain->
                                   [(mem phi0 G0)
                                     ==> (mem vb ord)
                                         [phi0-eq (G0 = ord)]]);
                            _ := (!refute-mem vb ord) }
                        (!from-false target))
              | (l-neg-rule f0 G0 A0 d0) =>
                  # Succedent none-succ vs some-succ (Var b).
                  (!both-orders (l-neg-rule f0 G0 A0 d0)
                    method (w ord)
                      let { _ := (!wf-elim w wf-l-neg
                                   [A0 G0 sb d0 f0 ord minimal-F]);
                            _ := (!absurd (sb = none-succ)
                                   (!sym (!instance none-neq-some [vb]))) }
                        (!from-false target))
              | (r-arrow-rule f0 G0 A0 B0 d0) =>
                  # Succedent Impl vs Var b: no-confusion.
                  (!both-orders (r-arrow-rule f0 G0 A0 B0 d0)
                    method (w ord)
                      let { _ := (!wf-elim w wf-r-arrow
                                   [A0 B0 G0 sb d0 f0 ord minimal-F]);
                            vimpl-eq := (!chain->
                                          [(sb = some-succ (Impl A0 B0))
                                            ==> (vb = (Impl A0 B0))
                                                [(datatype-axioms "Succedent")]]);
                            _ := (!absurd vimpl-eq
                                   (!instance var-neq-impl [b A0 B0])) }
                        (!from-false target))
              | (l-arrow-rule f0 G0 A0 B0 sc0 d1 d2) =>
                  # ord1: head (A->B)->B = Impl A0 B0, PRODUCTIVE case:
                  #   the left premise is [Neg A] |- A->B, and
                  #   R-arrow-inv-NegA-min concludes. (Coq: apply
                  #   R_arrow_inv_NegA_min.)
                  # ord2: head Neg A vs Impl A0 B0, impossible.
                  (!both-orders (l-arrow-rule f0 G0 A0 B0 sc0 d1 d2)
                    method (w ord)
                      let { _ := (!wf-elim w wf-l-arrow
                                   [A0 B0 G0 f0 ord sb sc0 d1 d2
                                    minimal-F]) }
                        check {
                          (ord equal? ord1) =>
                            let { head-eq := (!chain->
                                               [(ord1 = ((Impl A0 B0) :: G0))
                                                 ==> (phi = (Impl A0 B0))
                                                     [(datatype-axioms "List")]]);
                                  tail-eq := (!chain->
                                               [(ord1 = ((Impl A0 B0) :: G0))
                                                 ==> ((na :: nil) = G0)
                                                     [(datatype-axioms "List")]]);
                                  A0-eq := (!chain->
                                             [head-eq
                                               ==> ((Impl va vb) = A0)
                                                   [(datatype-axioms "Formula")]]);
                                  _ := (!chain->
                                         [(well-formed d1 f0 G0 (some-succ A0))
                                           ==> (well-formed d1 minimal-F
                                                  (na :: nil)
                                                  (some-succ (Impl va vb)))
                                               [(f0 = minimal-F)
                                                tail-eq A0-eq]]);
                                  dleft := (!derivable! minimal-F (na :: nil)
                                              (some-succ (Impl va vb)) d1) }
                              (!mp (!uspec (!uspec R-arrow-inv-NegA-min a) b)
                                   dleft)
                        | else =>
                            let { head-eq := (!chain->
                                               [(ord2 = ((Impl A0 B0) :: G0))
                                                 ==> (na = (Impl A0 B0))
                                                     [(datatype-axioms "List")]]);
                                  _ := (!absurd head-eq
                                         (!instance neg-neq-impl
                                           [va A0 B0])) }
                              (!from-false target)
                        })
              | (exchange-rule f0 xf0 yf0 sc0 d0) =>
                  # Productive in both orderings: the premise lives on
                  # the PERMUTED ordering, which the induction
                  # hypothesis covers via the disjunction. h/t =
                  # head/tail of ord; the premise context [xf0,yf0] is
                  # the other ordering.
                  let { ih := (((well-formed d0 minimal-F ord1 sb)
                                | (well-formed d0 minimal-F ord2 sb))
                               ==> target) }
                    (!both-orders (exchange-rule f0 xf0 yf0 sc0 d0)
                      method (w ord)
                        let { other := check {(ord equal? ord1) => ord2
                                             | else => ord1};
                              h := check {(ord equal? ord1) => phi
                                         | else => na};
                              t := check {(ord equal? ord1) => na
                                         | else => phi};
                              _ := (!wf-elim w wf-exchange
                                     [d0 f0 xf0 yf0 ord sb sc0 minimal-F]);
                              yf0-eq := (!chain->
                                          [(ord = (yf0 :: (xf0 :: nil)))
                                            ==> (h = yf0)
                                                [(datatype-axioms "List")]]);
                              tail-c := (!chain->
                                          [(ord = (yf0 :: (xf0 :: nil)))
                                            ==> ((t :: nil) = (xf0 :: nil))
                                                [(datatype-axioms "List")]]);
                              xf0-eq := (!chain->
                                          [tail-c
                                            ==> (t = xf0)
                                                [(datatype-axioms "List")]]);
                              prem-rw := (!chain->
                                           [(well-formed d0 f0
                                              (xf0 :: (yf0 :: nil)) sc0)
                                             ==> (well-formed d0 minimal-F
                                                    other sb)
                                                 [(f0 = minimal-F) (sc0 = sb)
                                                  xf0-eq yf0-eq]]);
                              disj-ih :=
                                check {(ord equal? ord1) =>
                                         (!right-either
                                           (well-formed d0 minimal-F ord1 sb)
                                           prem-rw)
                                      | else =>
                                         (!left-either
                                           prem-rw
                                           (well-formed d0 minimal-F ord2 sb))} }
                          (!mp ih disj-ih))
              | (r-arrow-core-rule G0 A0 B0 d0) =>
                  # Fragment core-logic vs minimal-F.
                  (!both-orders (r-arrow-core-rule G0 A0 B0 d0)
                    method (w ord)
                      let { _ := (!wf-elim w wf-r-arrow-core
                                   [A0 B0 G0 sb d0 ord minimal-F]);
                            _ := (!absurd (minimal-F = core-logic)
                                   (head (datatype-axioms "Fragment"))) }
                        (!from-false target))
            }
        }
      # From the hypothesis (ordering 1), extract the witness and feed
      # Hgen through the left disjunct.
      assume hyp := (derivable minimal-F ord1 sb)
        let { ex-d := (!chain->
                        [hyp
                          ==> (exists ?d:Deriv .
                                 (well-formed ?d minimal-F ord1 sb))
                              [derivable-def]]) }
          pick-witness w for ex-d wf-w
            (!mp (!uspec Hgen-proof w)
                 (!left-either wf-w (well-formed w minimal-F ord2 sb)))

#============================================================================
# THEOREM DNS1-anti-instantiated: contrapositive of DNS1-inv.
#         A, D |/- B
#    ---------------------
#    (A -> B) -> B, D |/- B
#============================================================================

define DNS1-anti-instantiated :=
  (forall ?a:Ide ?b:Ide .
    ((derivable minimal-F
                ((Var ?a) :: ((Neg (Var ?a)) :: nil))
                (some-succ (Var ?b))) ==> false)
    ==>
    ((derivable minimal-F
                ((Impl (Impl (Var ?a) (Var ?b)) (Var ?b))
                  :: ((Neg (Var ?a)) :: nil))
                (some-succ (Var ?b))) ==> false))

conclude DNS1-anti-instantiated
  pick-any a:Ide b:Ide
    assume H1 := ((derivable minimal-F
                             ((Var a) :: ((Neg (Var a)) :: nil))
                             (some-succ (Var b))) ==> false)
      assume H2 := (derivable minimal-F
                              ((Impl (Impl (Var a) (Var b)) (Var b))
                                :: ((Neg (Var a)) :: nil))
                              (some-succ (Var b)))
        (!mp H1 (!mp (!uspec (!uspec DNS1-inv-instantiated a) b) H2))

#============================================================================
# AXIOMS (the only two of the development, as in Coq)
#============================================================================

# Claim1-Tennant: Tennant's antisequent Neg A, A |/- B
# (Core Logic, p. 156).

assert Claim1-Tennant :=
  (forall ?a:Ide ?b:Ide .
    (derivable core-logic
               ((Var ?a) :: ((Neg (Var ?a)) :: nil))
               (some-succ (Var ?b))) ==> false)

# min-antisequent-rule-to-core: any antisequent rule established by
# induction on the rules of F shared by M and C transfers from
# minimal-F to core-logic.

assert min-antisequent-rule-to-core :=
  (forall ?G:(List Formula) ?G2:(List Formula)
          ?C:Succedent ?C2:Succedent .
    (((derivable minimal-F ?G ?C) ==> false)
     ==> ((derivable minimal-F ?G2 ?C2) ==> false))
    ==>
    (((derivable core-logic ?G ?C) ==> false)
     ==> ((derivable core-logic ?G2 ?C2) ==> false)))

#============================================================================
# THEOREM claim1-false: the final contradiction (paper Section 2.5).
#   (1) DNS.1-anti (minimal-F), lifted to core-logic by the transfer.
#   (2) Applied to Claim1-Tennant: the fatal antisequent.
#   (3) DNS.2 on absurdity-core: the corresponding sequent.
#   (4) (2) and (3) contradict: false.
#============================================================================

define claim1-false :=
  (forall ?a:Ide ?b:Ide . false)

conclude claim1-false
  pick-any a:Ide b:Ide
    let { dns1-anti-ab := (!uspec (!uspec DNS1-anti-instantiated a) b);
          transfer-inst :=
            (!uspec* min-antisequent-rule-to-core
              [((Var a) :: ((Neg (Var a)) :: nil))
               ((Impl (Impl (Var a) (Var b)) (Var b))
                 :: ((Neg (Var a)) :: nil))
               (some-succ (Var b))
               (some-succ (Var b))]);
          Hanti-core := (!mp transfer-inst dns1-anti-ab);
          fatal-anti := (!mp Hanti-core
                             (!uspec (!uspec Claim1-Tennant a) b));
          seq-deriv := (!mp (!uspec (!uspec DNS2-instantiated a) b)
                            (!uspec absurdity-core a)) }
      (!mp fatal-anti seq-deriv)
